# Ignore everything by default
**

# Allow backend-code
!backend/
!backend/**

# Allow only git-references
!.git/
!.git/HEAD
!.git/refs/
!.git/refs/**
!.git/packed-refs

# Docs
!docs/
!docs/**

# Local build data
**/bin/
**/obj/
**/.vs/
**/.idea/
**/build/
**/.docusaurus/
**/node_modules/

# Private files
**/.env
**/.env.*
